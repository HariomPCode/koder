# Host-run backend and workers use the Compose-published services on localhost.
MONGODB_URI=mongodb://127.0.0.1:27017/koder
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Backend
JWT_SECRET=replace-with-a-local-development-secret

# Rate limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_FAIL_OPEN=false
RATE_LIMIT_PRACTICE_SUBMISSION_MAX=20
RATE_LIMIT_PRACTICE_SUBMISSION_WINDOW_SECONDS=60
RATE_LIMIT_CONTEST_SUBMISSION_MAX=30
RATE_LIMIT_CONTEST_SUBMISSION_WINDOW_SECONDS=60
RATE_LIMIT_SUBMISSION_FAIL_OPEN=true

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
