{
  "name": "koder-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "workers"
  ],
  "scripts": {
    "test": "npm run test:ci --workspace=backend && npm run test:ci --workspace=workers",
    "test:ci": "npm run test:ci --workspace=backend && npm run test:ci --workspace=workers",
    "dev:backend": "npm run dev --workspace=backend",
    "worker:js": "npm run worker:js --workspace=workers",
    "worker:java": "npm run worker:java --workspace=workers",
    "worker:python": "npm run worker:python --workspace=workers"
  },
  "devDependencies": {
    "ioredis": "^5.11.1"
  }
}
